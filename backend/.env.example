PORT=3000
CORS_ORIGIN=http://localhost:5173

# X.com Cookies (从浏览器开发者工具获取)
X_AUTH_TOKEN=your_auth_token_here
X_CT0=your_ct0_token_here

# X API Bearer Token (从浏览器开发者工具获取，X.com 的 API 认证使用)
# 在浏览器 Network 中找到任意 X API 请求，复制 Authorization 头中的 Bearer token
X_BEARER_TOKEN=your_bearer_token_here

# X API Query ID 配置（可选，ID变化时在此更新）
# 抓取方法：x.com → F12 → Network → 找 HomeTimeline / HomeLatestTimeline
HOME_TIMELINE_QUERY_ID=MpnCeE0hy8m5eWobPx8euw
HOME_LATEST_TIMELINE_QUERY_ID=MpnCeE0hy8m5eWobPx8euw
